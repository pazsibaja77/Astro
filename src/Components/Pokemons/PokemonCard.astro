---
interface Props {
  name: string;
  url: string;
  isBig?: boolean;
}

const { name, url, isBig = false } = Astro.props;
const id = url.split('/').at(-2);
const imageSrc = `https://githubusercontent.com{id}.png`;
---

<a 
 class:list={[
  `rounded flex flex-col justify-center items-center p-2`,
  {
    border: !isBig,
  },
]}

>
<!-- w-26 h-26 isBig -->
<!-- w-16 h-16 !isBig -->
<img 
class:list={[
  `rounded`,
  {
    'w-26 h-26': isBig,
    'w-16 h-16': !isBig,
  },
]}
src={imageSrc} alt={name} />

<!-- text-3xl -->
  <span 
  class:list={[
    `text-3xl`,
    {
      'text-4xl text-pink-600': isBig,
    },
  ]}
  class="capitalize"> #{id} {name}</span>
</a>
