---
import '../styles/global.css';

interface Props {
  title: string;
  imageSrc?: string;
  description?: string;
}
const { title = siteInfo.title,description, imageSrc } = siteInfo.description 
Astro.props;
---

<html lang="en">
  <head>
      <meta charset="utf-8" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" href="/favicon.ico" />
      <meta name="viewport" content="width=device-width" />
      <meta name="generator" content={Astro.generator} />

    <!--- SEO --->
    <meta name="description" content={description} />
    <meta name="generator" content={'Paz Sibaja'} />
    <!-- OG Metatags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {imageSrc && <meta property="og:image" content={imageSrc} />}

    <!--- Required--->
      <title>{title}</title>
      <meta name="description" content={description} />
      {imageSrc && <meta name="image" content={imageSrc} />}

      <Viewtransition/>
  </head>
  <body class="bg-slate-800 text-slate-100 m-auto max-w-3xl">
      <main class="mt-10">  
       <slot />
      </main>
    
  </body>
</html>
